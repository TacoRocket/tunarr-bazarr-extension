{
  "id": "bazarr",
  "version": "1.1.3",
  "apiVersion": "0.5",
  "entrypoint": "adapter.js",
  "sha256": "c8e95e099802f31922d0f3e08c1256bcd29b8bec484ca8d0caf39706583d7e74",
  "name": "Bazarr",
  "description": "Check which subtitles Bazarr has for a movie, and ask Bazarr to search for the missing ones.",
  "maintainer": "TacoRocket",
  "issueTracker": "https://github.com/TacoRocket/tunarr-bazarr-extension/issues",
  "accessGuide": {
    "reads": "Uses your selected movie's ID to check subtitle availability in Bazarr.",
    "changes": "Starts a subtitle search when you ask.",
    "connectsTo": "Contacts your Bazarr server, which may contact your subtitle providers.",
    "downloads": "Bazarr downloads any subtitles it finds."
  },
  "settings": [
    {
      "key": "bazarrUrl",
      "type": "url",
      "label": "Bazarr URL",
      "required": true,
      "placeholder": "http://bazarr:6767",
      "help": "Include the port and any URL base configured in Bazarr."
    },
    {
      "key": "apiKey",
      "type": "secret",
      "label": "API key",
      "required": true,
      "help": "In Bazarr, open Settings → General → Security."
    }
  ],
  "setupHelp": "Enter the address Tunarr can use to reach Bazarr, and Bazarr's API key.",
  "connectionTest": true,
  "actions": [
    {
      "id": "lookup",
      "label": "Check subtitles",
      "inputs": [
        {
          "key": "program",
          "type": "tunarrProgram",
          "label": "Movie",
          "required": true
        }
      ],
      "resultLabels": {
        "found": "Subtitles Bazarr has",
        "stillMissing": "Still missing"
      },
      "quick": true
    },
    {
      "id": "search",
      "label": "Search for missing subtitles",
      "inputs": [
        {
          "key": "program",
          "type": "tunarrProgram",
          "label": "Movie",
          "required": true
        }
      ],
      "resultLabels": {
        "found": "Subtitles Bazarr has",
        "stillMissing": "Still missing"
      },
      "quick": true
    }
  ],
  "requests": [
    {
      "id": "movies",
      "method": "GET",
      "baseUrlSetting": "bazarrUrl",
      "path": "api/movies",
      "query": [
        "start",
        "length",
        "radarrid[]"
      ],
      "credential": {
        "setting": "apiKey",
        "header": "X-API-KEY"
      }
    },
    {
      "id": "searchMissing",
      "method": "PATCH",
      "baseUrlSetting": "bazarrUrl",
      "path": "api/movies",
      "query": [
        "radarrid",
        "action"
      ],
      "credential": {
        "setting": "apiKey",
        "header": "X-API-KEY"
      }
    }
  ]
}
